# Use this only for a host-native API talking to the local Compose database.
DATABASE_URL=postgresql+psycopg://peyajflow:peyajflow-local@127.0.0.1:5432/peyajflow
APP_ENV=development
DEMO_MODE=true
PHOTO_STORAGE=local
TELEPHONY_PROVIDER=disabled
SMS_PROVIDER=disabled
# Required for signed provider callbacks when a provider is enabled.
PUBLIC_API_ORIGIN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_VOICE_GREETING_URL=
# Hosted photo storage uses PHOTO_STORAGE=s3 and a private bucket.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
